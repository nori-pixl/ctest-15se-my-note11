import http.server
import json
import mysql.connector
import datetime

# パスワードなしのroot接続
def get_db():
    return mysql.connector.connect(
        host="localhost", user="root", password="", database="bbs_db"
    )

def init_db():
    with get_db() as conn:
        with conn.cursor() as cur:
            cur.execute("CREATE TABLE IF NOT EXISTS classes (id INT PRIMARY KEY, name TEXT)")
            cur.execute("CREATE TABLE IF NOT EXISTS threads (id INT AUTO_INCREMENT PRIMARY KEY, cid INT, title TEXT)")
            cur.execute("CREATE TABLE IF NOT EXISTS posts (id INT AUTO_INCREMENT PRIMARY KEY, tid INT, n TEXT, b TEXT, d TEXT)")
            cur.execute("SELECT count(*) FROM classes WHERE id = 1")
            if cur.fetchone()[0] == 0:
                cur.execute("INSERT INTO classes (id, name) VALUES (1, '一般クラス')")
        conn.commit()

try:
    init_db()
except:
    pass

class JSONBBSHandler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length)
        req = json.loads(post_data.decode('utf-8'))
        
        response_data = {"status": "ok"}
        path = self.path
        
        with get_db() as conn:
            with conn.cursor() as cur:
                if path == '/api/get_classes':
                    vlist = req.get("vlist", [])
                    items = []
                    for vid in vlist:
                        if not str(vid).isdigit(): continue
                        cur.execute("SELECT id, name FROM classes WHERE id=%s", (int(vid),))
                        res = cur.fetchone()
                        # ⚠️ エラーの原因だった箇所。タプルから直接値を取り出して安全な配列にします
                        if res:
                            items.append([int(res[0]), str(res[1])])
                    response_data = {"items": items}
                    
                elif path == '/api/check_class':
                    fid = req.get("fid", 0)
                    if str(fid).isdigit():
                        cur.execute("SELECT id FROM classes WHERE id=%s", (int(fid),))
                        response_data = {"exists": True if cur.fetchone() else False}
                    else:
                        response_data = {"exists": False}
                    
                elif path == '/api/add_class':
                    cur.execute("INSERT INTO classes (id, name) VALUES (%s, %s)", (req["id"], req["name"]))
                    conn.commit()
                    
                elif path == '/api/get_class_detail':
                    cur.execute("SELECT name FROM classes WHERE id=%s", (req["cid"],))
                    res_c = cur.fetchone()
                    cname = str(res_c[0]) if res_c else "不明"
                    
                    cur.execute("SELECT id, title FROM threads WHERE cid=%s ORDER BY id DESC", (req["cid"],))
                    ts = cur.fetchall()
                    threads = []
                    for t in ts:
                        threads.append([int(t[0]), str(t[1])])
                    response_data = {"cname": cname, "threads": threads}
                    
                elif path == '/api/add_thread':
                    cur.execute("INSERT INTO threads (cid, title) VALUES (%s, %s)", (req["cid"], req["title"]))
                    tid = cur.lastrowid
                    cur.execute("INSERT INTO posts (tid, n, b, d) VALUES (%s, %s, %s, %s)", (tid, req["n"], req["b"], datetime.datetime.now().strftime('%m/%d %H:%M')))
                    conn.commit()
                    response_data = {"tid": int(tid) if tid else 0}
                    
                elif path == '/api/get_thread_detail':
                    cur.execute("SELECT title FROM threads WHERE id=%s", (req["tid"],))
                    res_t = cur.fetchone()
                    tname = str(res_t[0]) if res_t else "不明"
                    
                    cur.execute("SELECT id, n, b, d FROM posts WHERE tid=%s ORDER BY id ASC", (req["tid"],))
                    ps = cur.fetchall()
                    posts = []
                    for p in ps:
                        posts.append([int(p[0]), str(p[2]), str(p[3]), str(p[4])])
                    response_data = {"tname": tname, "posts": posts}
                    
                elif path == '/api/add_post':
                    cur.execute("INSERT INTO posts (tid, n, b, d) VALUES (%s, %s, %s, %s)", (req["tid"], req["n"], req["b"], datetime.datetime.now().strftime('%m/%d %H:%M')))
                    conn.commit()
                    
                elif path == '/api/del_class':
                    cur.execute("DELETE FROM posts WHERE tid IN (SELECT id FROM threads WHERE cid=%s)", (req["cid"],))
                    cur.execute("DELETE FROM threads WHERE cid=%s", (req["cid"],))
                    cur.execute("DELETE FROM classes WHERE id=%s", (req["cid"],))
                    conn.commit()
                    
                elif path == '/api/del_thread':
                    cur.execute("DELETE FROM posts WHERE tid=%s", (req["tid"],))
                    cur.execute("DELETE FROM threads WHERE id=%s", (req["tid"],))
                    conn.commit()
                    
                elif path == '/api/del_post':
                    cur.execute("DELETE FROM posts WHERE id=%s", (req["pid"],))
                    conn.commit()

        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(response_data).encode('utf-8'))

    def log_message(self, format, *args):
        return

if __name__ == '__main__':
    import http.server
    server = http.server.HTTPServer(('0.0.0.0', 5000), JSONBBSHandler)
    print("BBS DATA SERVER STARTED (PORT: 5000)")
    server.serve_forever()
